# The toolchain CI builds with, stated once. scripts/ci/select-xcode selects and asserts the Xcode; scripts/ci/simulator-destination
# picks the simulator. Change these together with docs/development/ci.md, after the runner image has them
# (docs/runbooks/xcode-update.md). Xcode 27.2 is the first that reads the JSON project format of Apps/Purlay.xcodeproj.
XCODE_VERSION=27.2
SIMULATOR_DEVICE=iPhone 17
SIMULATOR_OS=27.2
