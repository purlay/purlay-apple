accept_in "QA: a sentence with two counts, in English substitutions with plural forms" . \
  "python3 -c '$(recatalogue $MAC_STRINGS 'forms = lambda one, other: {"plural": {"one": {"stringUnit": {"state": "translated", "value": one}}, "other": {"stringUnit": {"state": "translated", "value": other}}}}; strings["%lld messages in %lld channels"] = {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%#@messages@ in %#@channels@"}, "substitutions": {"messages": {"argNum": 1, "formatSpecifier": "lld", "variations": forms("%arg message", "%arg messages")}, "channels": {"argNum": 2, "formatSpecifier": "lld", "variations": forms("%arg channel", "%arg channels")}}}, "tr": {"stringUnit": {"state": "translated", "value": "%2$lld kanalda %1$lld mesaj"}}}}')' \
    && printf '%s\\n' 'let qaMulti = Text(\"\\(1) messages in \\(2) channels\")' >> Sources/PurlayMacUI/Strings.swift"
