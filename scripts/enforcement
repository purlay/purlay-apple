# QA (pr6-third): the code's own APIs and assignments the sentence rule must read, and a receiver it must not guess.
# A view keeps its title as a Text and takes its action first: the sentence is a parameter after a closure's parentheses.
accept_in "QA: the code's own initialiser taking a sentence after a closure parameter" . \
  "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Said A"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Söylendi A"}}}}')' \
    && printf '%s\\n' 'struct QARow: View { let label: Text; let action: () -> Void' '  init(action: @escaping () -> Void, title: LocalizedStringKey) { self.action = action; label = Text(title) }' '  var body: some View { Button(action: action) { label } } }' 'let qaRow = QARow(action: {}, title: \"Said A\")' >> Sources/PurlayMacUI/Strings.swift"
accept_in "QA: the code's own function taking a sentence after a default value with parentheses" . \
  "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Said B"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Söylendi B"}}}}')' \
    && printf '%s\\n' 'func qaShow(size: CGSize = CGSize(width: 1, height: 1), title: LocalizedStringKey) {}' 'let qaShown: Void = qaShow(title: \"Said B\")' >> Sources/PurlayMacUI/Strings.swift"
accept_in "QA: a sentence assigned through an optional chain whose type the code states" . \
  "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Said D"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Söylendi D"}}}}')' \
    && printf '%s\\n' 'struct QAH { var title: LocalizedStringKey = \"Starred\" }' 'final class QAM { var holder: QAH?; func set() { holder?.title = \"Said D\" } }' >> Sources/PurlayMacUI/Strings.swift"
# A receiver's type is the one its own declaration states, not that of another declaration of the same name in the file.
plant_in "QA: a Mac sentence assigned to an AppKit receiver named like a parameter typed elsewhere" . "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Never said"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Hiç söylenmedi"}}}}')' && printf '%s\\n' 'import AppKit' 'struct QAHolder { var title: LocalizedStringKey }' 'func qaUse(menu: QAHolder) {}' 'func qaProbe() { let menu = NSMenuItem(); menu.title = \"Never said\" }' >> Sources/PurlayMacUI/Strings.swift"
# QA (pr6-fourth): a name bound again without a stated type (if let, a closure's parameter, for-in) is not the outer declaration.
plant_in "QA: a Mac sentence assigned to AppKit values rebound under the name of a parameter typed elsewhere" . "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Never said"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Hiç söylenmedi"}}}}')' && printf '%s\\n' 'import AppKit' 'struct QAHolder { var title: LocalizedStringKey }' 'func qaIf(menu: QAHolder, item: NSMenuItem?) { if let menu = item { menu.title = \"Never said\" } }' 'func qaClosure(menu: QAHolder, items: [NSMenuItem]) { items.forEach { menu in menu.title = \"Never said\" } }' 'func qaFor(menu: QAHolder, items: [NSMenuItem]) { for menu in items { menu.title = \"Never said\" } }' >> Sources/PurlayMacUI/Strings.swift"
# QA (pr9): a holder unwrapped under its own name keeps its type: `if var holder` is the outer `holder: QAH?`, unwrapped.
accept_in "QA: a sentence assigned through a holder unwrapped by if-var shorthand" . \
  "python3 -c '$(recatalogue $MAC_STRINGS 'strings["Said E"] = {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": "Söylendi E"}}}}')' \
    && printf '%s\\n' 'struct QAE { var title: LocalizedStringKey = \"Starred\" }' 'func qaSet(holder: QAE?) { if var holder { holder.title = \"Said E\"; _ = holder } }' >> Sources/PurlayMacUI/Strings.swift"
wait
judged=0
for name in "$RESULTS"/*.name; do
  [ -e "$name" ] || continue
  result="${name%.name}"
  verdicts="$(grep -cE '^  (refused|accepted|NOT REFUSED|NOT ACCEPTED|BROKEN) ' "$result" 2>/dev/null || true)"
  if [ "$(cat "$result.status" 2>/dev/null)" != 0 ] || [ "$verdicts" != 1 ]; then
    echo "  NO VERDICT   $(cat "$name") (the job ended with status $(cat "$result.status" 2>/dev/null || echo none))" >&2
    fail=1
  elif grep -qE '^  (NOT |BROKEN)' "$result"; then
    cat "$result" >&2; fail=1
  else
    cat "$result"
  fi
  judged=$((judged + 1))
done
if [ "$judged" != "$job" ]; then
  echo "  $job jobs were started and $judged reported" >&2; fail=1
fi
exit $fail
