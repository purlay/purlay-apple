# QA (pr6-recheck): sentences said by code the next slices write, which the rule must not refuse.
# AppIntents' titles, descriptions and dialogs take LocalizedStringResource; the SDK interfaces read are SwiftUI and Foundation only.
INTENT_SENTENCES="$(printf '%s\n' 'import AppIntents' \
  'struct QAOpen: AppIntent { static let title: LocalizedStringResource = "Intent 1"' \
  '  static let description = IntentDescription("Intent 2")' \
  '  @Parameter(title: "Intent 3") var name: String' \
  '  func perform() async throws -> some IntentResult & ProvidesDialog { .result(dialog: "Intent 4") } }' \
  'struct QAEntity: AppEntity { static let typeDisplayRepresentation = TypeDisplayRepresentation(name: "Intent 5")' \
  '  static let defaultQuery = QAQuery(); var id: String' \
  '  var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "Intent 6") } }' \
  'struct QAQuery: EntityQuery { func entities(for identifiers: [String]) async throws -> [QAEntity] { [] } }')"
export INTENT_SENTENCES
accept_in "QA: an App Intent's title, description, parameter, dialog and display representations" . \
  "python3 -c '$(recatalogue $IOS_STRINGS 'strings.update({f"Intent {n}": {"localizations": {"tr": {"stringUnit": {"state": "translated", "value": f"Niyet {n}"}}}} for n in range(1, 7)})')' && printf '%s\\n' \"\$INTENT_SENTENCES\" > Apps/iOS/App/QAIntents.swift"
