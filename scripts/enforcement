#!/usr/bin/env bash
# The architecture rules a compiler does not state by itself, and the values that must be one value. Each rule is also run
# against a copy of the tree with the violation planted, so a rule that stopped looking is seen here and not discovered in review.
#
#   scripts/enforcement [GROUP]          check the tree
#   scripts/enforcement --demo [GROUP]   plant each violation in a copy and require the check to refuse it
#
# GROUP is `tree`, `layers`, or both when it is left out. `tree` is shell, grep and Python only, so it runs on a Linux runner
# without Swift (scripts/verify rules). `layers` reads the package through `swift package dump-package`, which compiles the
# manifest and so needs the Swift toolchain: it runs on macOS (scripts/verify packages).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

demo=false
if [ "${1:-}" = "--demo" ]; then demo=true; shift; fi
case "${1:-all}" in
  tree | layers) RULE_GROUPS="$1" ;;
  all) RULE_GROUPS="tree layers" ;;
  *) echo "usage: scripts/enforcement [--demo] [tree|layers]" >&2; exit 2 ;;
esac
wants() { case " $RULE_GROUPS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# What a copy for the demonstration holds: everything a rule reads.
TREE=(Package.swift Sources Tests Apps Config Design TestPlans Tools)

png_field() { # file offset length: that many bytes of the PNG header as a number (od and bash only: this runs on a Linux runner too)
  local hex
  hex="$(od -An -tx1 -j"$2" -N"$3" "$1" | tr -d ' \n')"
  echo "$((16#$hex))"
}

# The layers: which module may depend on which. A module the table does not name is refused, so a new one is placed on purpose.
# The manifest is read through SwiftPM, which compiles it; what it says is kept by the manifest's digest, so the demonstration,
# which copies the same manifest many times, reads it once.
dump_package() { # root
  local cache digest
  cache="${TMPDIR:-/tmp}/purlay-enforcement"
  digest="$(shasum -a 256 "$1/Package.swift" | cut -d' ' -f1)"
  if [ ! -s "$cache/$digest.json" ]; then
    mkdir -p "$cache"
    (cd "$1" && swift package dump-package) > "$cache/$digest.json.partial" || { rm -f "$cache/$digest.json.partial"; return 1; }
    mv "$cache/$digest.json.partial" "$cache/$digest.json"
  fi
  cat "$cache/$digest.json"
}

layers() { # root
  local dump
  dump="$(dump_package "$1")" || { echo "FAIL: swift package dump-package cannot read $1/Package.swift" >&2; return 1; }
  printf '%s' "$dump" | python3 -c '
import json, re, sys
allowed = {
    "PurlayContract": set(), "PurlayTokens": set(),
    "PurlayKit": {"PurlayContract"},
    "PurlayWords": {"PurlayKit", "PurlayContract"},
    "PurlayTestSupport": {"PurlayKit", "PurlayContract"},
    "PurlayDesign": {"PurlayTokens"},
    "PurlayModuleAPI": set(),
    "PurlayMacUI": {"PurlayKit", "PurlayContract", "PurlayTokens", "PurlayDesign", "PurlayWords"},
}
feature = {"PurlayKit", "PurlayContract", "PurlayTokens", "PurlayDesign", "PurlayModuleAPI", "PurlayWords"}
package = json.load(sys.stdin)
failed = False
for target in package["targets"]:
    if target["type"] != "regular":
        continue
    name = target["name"]
    names = set()
    for dependency in target.get("dependencies", []):
        (kind, value), = dependency.items()
        names.add(value[0])
    if re.fullmatch(r"Feature[A-Z][A-Za-z0-9]*", name):
        may = feature
    elif name in allowed:
        may = allowed[name]
    else:
        print(f"FAIL: {name} is a module the layer table does not name", file=sys.stderr); failed = True; continue
    for wrong in sorted(names - may):
        print(f"FAIL: {name} depends on {wrong}, which its layer does not allow", file=sys.stderr); failed = True
sys.exit(1 if failed else 0)'
}

# Every floor, as each file that states one says it: "platform major", one per line.
floors() { # root
  local root="$1"
  find "$root" -name Package.swift -not -path '*/.build/*' -print0 | xargs -0 grep -hoE '\.(iOS|macOS)\(\.v[0-9]+\)' \
    | sed -E 's/\.(iOS|macOS)\(\.v([0-9]+)\)/\1 \2/'
  grep -hE '^IPHONEOS_DEPLOYMENT_TARGET *=' "$root"/Config/*.xcconfig | sed -E 's/.*= *([0-9]+).*/iOS \1/'
  grep -hE '^MACOSX_DEPLOYMENT_TARGET *=' "$root"/Config/*.xcconfig | sed -E 's/.*= *([0-9]+).*/macOS \1/'
}

check() { # root: the groups asked for
  local failed=0
  if wants layers && ! layers "$1"; then failed=1; fi
  if wants tree && ! check_tree "$1"; then failed=1; fi
  return $failed
}

check_tree() { # root: every rule but the layers
  local root="$1" failed=0

  # --- The structure.
  # A feature never imports another feature (the layer rule sees the manifest; this sees the code).
  for feature in "$root"/Sources/Feature*/; do
    [ -d "$feature" ] || continue
    name="$(basename "$feature")"
    if grep -rnE --include='*.swift' '^\s*(@testable )?import Feature' "$feature" | grep -vE "import $name\b"; then
      echo "FAIL: $name imports another feature" >&2; failed=1
    fi
  done
  # The engine, the contract, the tokens and the engine's words are platform-neutral: no UI framework. Each app draws its own
  # interface.
  if grep -rnE '^\s*(@_exported )?import (SwiftUI|AppKit|UIKit|WatchKit)\b' \
      "$root"/Sources/{PurlayContract,PurlayTokens,PurlayKit,PurlayWords,PurlayTestSupport}; then
    echo "FAIL: the engine, the contract, the tokens or the engine's words import a UI framework" >&2; failed=1
  fi
  # OS-version branching lives in PurlayDesign alone.
  if grep -rnE --include='*.swift' '#available|#unavailable|@available' "$root/Sources" "$root/Tests" "$root/Apps" \
      | grep -v "^$root/Sources/PurlayDesign/"; then
    echo "FAIL: an OS-version check outside Sources/PurlayDesign" >&2; failed=1
  fi
  # One floor per platform, and Package.swift and Config/ both state it.
  for platform in iOS macOS; do
    numbers="$(floors "$root" | awk -v p="$platform" '$1 == p {print $2}' | sort -u)"
    if [ "$(printf '%s\n' "$numbers" | grep -c .)" != "1" ]; then
      echo "FAIL: the $platform floor is not one number:" >&2; floors "$root" | grep "^$platform " | sort | uniq -c >&2; failed=1
    fi
  done
  if ! grep -qE '\.iOS\(\.v[0-9]+\)' "$root/Package.swift" || ! grep -qE '\.macOS\(\.v[0-9]+\)' "$root/Package.swift" \
      || ! grep -qE '^IPHONEOS_DEPLOYMENT_TARGET *=' "$root"/Config/*.xcconfig \
      || ! grep -qE '^MACOSX_DEPLOYMENT_TARGET *=' "$root"/Config/*.xcconfig; then
    echo "FAIL: a floor is not stated in both Package.swift and Config/" >&2; failed=1
  fi
  # The project holds no build setting: every one is in Config/, where a review sees it.
  if grep -nE '"build-settings"' "$root/Apps/Purlay.xcodeproj/project.xcproj"; then
    echo "FAIL: Apps/Purlay.xcodeproj holds build settings; put them in Config/" >&2; failed=1
  fi
  # One package for the apps' modules and every test of them: a second one is built by no lane unless one is written for it,
  # and resolves the root only by its folder's name. The code generator is a tool of its own, run by `scripts/verify generated`.
  if find "$root" -name Package.swift -not -path '*/.build/*' -not -path "$root/Package.swift" \
      -not -path "$root/Tools/PurlayGen/Package.swift" | grep .; then
    echo "FAIL: a second Swift package; make its tests a test target of Package.swift" >&2; failed=1
  fi
  # Every test target runs: each is in the test plan of a lane (scripts/verify runs macOS and iOS).
  for target in $(tr '\n' ' ' < "$root/Package.swift" | grep -oE 'tests\( *"[A-Za-z0-9]+"' | grep -oE '"[A-Za-z0-9]+"' | tr -d '"') \
      PurlayTests PurlayUITests; do
    if ! grep -qE "\"name\" : \"$target\"" "$root"/TestPlans/{macOS,iOS}.xctestplan; then
      echo "FAIL: the test target $target is in no test plan a lane runs" >&2; failed=1
    fi
  done

  # --- Dependencies and code that can trap.
  # The package has no third-party dependency; the project's are the ones M-8 allows (Sparkle; swift-markdown if needed).
  if grep -nE '\.package\(' "$root/Package.swift"; then
    echo "FAIL: a package dependency in Package.swift; the modules have none" >&2; failed=1
  fi
  if grep -oE '"repository": *"[^"]+"' "$root/Apps/Purlay.xcodeproj/project.xcproj" \
      | grep -vE 'github\.com/(sparkle-project/Sparkle|swiftlang/swift-markdown)"'; then
    echo "FAIL: a project dependency M-8 does not allow" >&2; failed=1
  fi
  # Only the Mac app's own folder for updates may import Sparkle.
  if grep -rnE --include='*.swift' '^\s*import Sparkle\b' "$root/Sources" "$root/Apps" | grep -v '/Apps/macOS/App/Updates/'; then
    echo "FAIL: Sparkle imported outside Apps/macOS/App/Updates" >&2; failed=1
  fi
  # The Mac screens open no connection: they reach the network only through PurlayKit's protocols.
  if grep -rnE '\b(URLSession|URLRequest|NWConnection|URLSessionWebSocketTask)\b' "$root/Sources/PurlayMacUI"; then
    echo "FAIL: PurlayMacUI touches the network" >&2; failed=1
  fi
  # No escape from the compiler's concurrency checking.
  if grep -rnE --include='*.swift' '(@unchecked Sendable|nonisolated\(unsafe\))' "$root/Sources" "$root/Apps" \
      | grep -v 'enforcement-allow'; then
    echo "FAIL: an unchecked concurrency escape" >&2; failed=1
  fi
  # Production code cannot trap on a value it was handed: no `try!`, `as!`, `fatalError`, and no force unwrap or implicitly
  # unwrapped optional. A trap cannot be caught, so the rule is prevention. Comment lines, generated code, the test support
  # library and the tests are not looked at.
  if grep -rnE --include='*.swift' '(try!|as!|fatalError\(|unsafelyUnwrapped|[]A-Za-z0-9_)]!([].),]|[[:space:]]*$))' \
      "$root/Sources" "$root"/Apps/*/App | grep -v '/Generated/' | grep -v '/PurlayTestSupport/' \
      | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//'; then
    echo "FAIL: production code that can trap" >&2; failed=1
  fi

  # --- The iOS app.
  # The icon is one 1024 by 1024 picture with no alpha channel (the App Store refuses one that has it, and the system rounds the
  # corners itself); scripts/icon writes it from Design/purlay.svg. PNG colour type 0 (grey) and 2 (RGB) have no alpha.
  local set="$root/Apps/iOS/App/Resources/Assets.xcassets/AppIcon.appiconset" icon="icon-1024.png"
  if [ ! -f "$set/$icon" ] || ! grep -q "\"$icon\"" "$set/Contents.json"; then
    echo "FAIL: the iOS icon set has no $icon" >&2; failed=1
  else
    if [ "$(png_field "$set/$icon" 16 4)x$(png_field "$set/$icon" 20 4)" != "1024x1024" ]; then
      echo "FAIL: $icon is not 1024x1024" >&2; failed=1
    fi
    case "$(png_field "$set/$icon" 25 1)" in
      0 | 2) ;;
      *) echo "FAIL: $icon has an alpha channel" >&2; failed=1 ;;
    esac
  fi
  # The launch screen's mark is the logo, drawn at the size PurlayMark has on the first frame: Design/purlay.svg with the root
  # width and height set to 120. Apart from that first line it is the logo byte for byte, so a change to the logo cannot leave it behind.
  local launch="$root/Apps/iOS/App/Resources/Assets.xcassets/LaunchMark.imageset/purlay-mark.svg"
  if [ ! -f "$launch" ]; then
    echo "FAIL: there is no launch mark ($launch)" >&2; failed=1
  elif ! cmp -s <(tail -n +2 "$launch") <(tail -n +2 "$root/Design/purlay.svg") \
      || ! head -n 1 "$launch" | grep -q '^<svg [^>]*width="120" height="120" viewBox="0 0 1024 1024"'; then
    echo "FAIL: the launch mark is not Design/purlay.svg at 120 pt (run scripts/icon)" >&2; failed=1
  fi
  # A button is built from a text label, never from a LocalizedStringResource: on the simulator `Button(Words.x)` showed English on a
  # Turkish device while `Text(Words.x)` beside it was Turkish.
  if grep -rnE --include='*.swift' 'Button\(Words\.' "$root/Apps/iOS/App"; then
    echo "FAIL: a button built from a LocalizedStringResource (use a Text label)" >&2; failed=1
  fi
  # A required-reason API that code in the iOS app uses is declared, with its category, in the privacy manifest (App Store refuses
  # a build otherwise). The app's code is its own folder and the modules it links.
  local manifest="$root/Apps/iOS/App/Resources/PrivacyInfo.xcprivacy"
  [ -f "$manifest" ] || { echo "FAIL: there is no privacy manifest" >&2; failed=1; }
  # Each declared category gives at least one reason, and only reasons Apple lists for that category: an unknown code is refused
  # at submission like a missing one.
  if [ -f "$manifest" ] && ! python3 - "$manifest" <<'PY'
import plistlib, sys
reasons = {
    "NSPrivacyAccessedAPICategoryUserDefaults": {"CA92.1", "1C8F.1", "C56D.1", "AC6B.1"},
    "NSPrivacyAccessedAPICategoryFileTimestamp": {"DDA9.1", "C617.1", "3B52.1", "0A2A.1"},
    "NSPrivacyAccessedAPICategorySystemBootTime": {"35F9.1", "8FFB.1", "3D61.1"},
    "NSPrivacyAccessedAPICategoryDiskSpace": {"85F4.1", "E174.1", "7D9E.1", "B728.1"},
    "NSPrivacyAccessedAPICategoryActiveKeyboards": {"3EC4.1", "54BD.1"},
}
problems = []
for entry in plistlib.load(open(sys.argv[1], "rb")).get("NSPrivacyAccessedAPITypes", []):
    category = entry.get("NSPrivacyAccessedAPIType")
    given = entry.get("NSPrivacyAccessedAPITypeReasons", [])
    if category not in reasons:
        problems.append(f"the privacy manifest declares an unknown category {category!r}")
    elif not given:
        problems.append(f"the privacy manifest gives no reason for {category}")
    else:
        problems += [f"{code!r} is not a reason Apple lists for {category}" for code in given if code not in reasons[category]]
for problem in problems:
    print("FAIL: " + problem, file=sys.stderr)
sys.exit(1 if problems else 0)
PY
  then failed=1; fi
  while IFS='|' read -r category pattern; do
    if grep -rlE --include='*.swift' "$pattern" "$root/Apps/iOS/App" \
        "$root"/Sources/{PurlayContract,PurlayTokens,PurlayKit,PurlayWords,PurlayDesign,PurlayModuleAPI} | grep -q .; then
      grep -q "NSPrivacyAccessedAPICategory$category" "$manifest" 2>/dev/null \
        || { echo "FAIL: code uses a $category API the privacy manifest does not declare" >&2; failed=1; }
    fi
  done <<'APIS'
UserDefaults|UserDefaults|@AppStorage
FileTimestamp|creationDate|modificationDate|fileModificationDate|fileCreationDate|attributesOfItem|\bf?stat\(
SystemBootTime|systemUptime|mach_absolute_time
DiskSpace|volumeAvailableCapacity|volumeTotalCapacity|systemFreeSize|statfs|getattrlist
ActiveKeyboards|activeInputModes
APIS

  # The logo is stated once, in Design/purlay.svg: PurlayMark and the Welcome field draw `Logo`, which scripts/icon writes from it.
  if ! scripts/logo-swift --check "$root"; then failed=1; fi
  # --- The sentences: one checker for every catalogue. The engine's sentences (PurlayWords) are said by both apps, so their
  # catalogue answers to every language either app declares; each app's own catalogue answers to the languages that app
  # declares (CFBundleLocalizations). A sentence has one home: a key in two catalogues is two translations that can drift.
  if ! python3 - "$root" <<'PY'
import json, plistlib, re, sys
root = sys.argv[1]
apps = {"iOS": "Apps/iOS", "macOS": "Apps/macOS"}
spec = re.compile(r"%(?:\d+\$)?(?:lld|ld|lu|llu|@|d|u|f)")
# Nothing to translate: only symbols, digits and format specifiers, or a code-like address.
inert = re.compile(r"^[^A-Za-z]*$|^[a-z0-9.\-/]+$")
plural_forms = {"zero", "one", "two", "few", "many", "other"}
problems = []

def declared(app):
    # The Info.plist is preprocessed by the build, so its #ifdef lines are taken out before it is read here.
    plist = plistlib.loads(re.sub(rb"(?m)^#.*\n", b"", open(f"{root}/{apps[app]}/Info.plist", "rb").read()))
    languages = plist.get("CFBundleLocalizations", [])
    if "en" not in languages or "tr" not in languages:
        problems.append(f"the {app} app does not declare English and Turkish (CFBundleLocalizations): {languages}")
    return set(languages)

languages = {app: declared(app) for app in apps}
catalogues = {
    "Apps/iOS/App/Resources/Localizable.xcstrings": languages["iOS"],
    "Apps/macOS/App/Resources/Localizable.xcstrings": languages["macOS"],
    "Sources/PurlayWords/Resources/Localizable.xcstrings": languages["iOS"] | languages["macOS"],
}

def norm(text):
    return sorted(re.sub(r"\d+\$", "", match) for match in spec.findall(text))

def units(path, key, language, localization):
    """Every value a language gives for a key: the one, or one per plural form, which must include `other`."""
    if "stringUnit" in localization:
        return [localization["stringUnit"]]
    plural = localization.get("variations", {}).get("plural")
    if plural is None:
        problems.append(f"{path}: {key!r} in {language} is neither a value nor plural forms")
        return []
    if "other" not in plural or not set(plural) <= plural_forms:
        problems.append(f"{path}: {key!r} in {language} has plural forms {sorted(plural)}, without `other` or with an unknown one")
    return [form.get("stringUnit", {}) for form in plural.values()]

homes = {}
for path, wanted in catalogues.items():
    catalogue = json.load(open(f"{root}/{path}"))
    if catalogue.get("sourceLanguage") != "en":
        problems.append(f"{path}: the source language is not en")
    for key, entry in catalogue["strings"].items():
        homes.setdefault(key, []).append(path)
        if entry.get("shouldTranslate") is False:
            continue
        if entry.get("extractionState") == "stale":
            problems.append(f"{path}: {key!r} is stale (no code says it any more); remove it")
            continue
        localizations = entry.get("localizations", {})
        for language in sorted(wanted - {"en"}):
            if language not in localizations:
                if not inert.match(spec.sub("", key)):
                    problems.append(f"{path}: {key!r} is not translated into {language}")
                continue
            for unit in units(path, key, language, localizations[language]):
                if unit.get("state") != "translated" or not unit.get("value", "").strip():
                    problems.append(f"{path}: {key!r} has no final {language} value ({unit.get('state')})")
                elif norm(unit["value"]) != norm(key):
                    problems.append(f"{path}: {key!r} -> {unit['value']!r}: the format specifiers differ")
        # The English forms are held to the same rule, so that a plural cannot drop an argument.
        if "en" in localizations:
            for unit in units(path, key, "en", localizations["en"]):
                if norm(unit.get("value", key)) != norm(key):
                    problems.append(f"{path}: an English form of {key!r} changes its arguments")
for key, paths in homes.items():
    if len(paths) > 1:
        problems.append(f"{key!r} is in {len(paths)} catalogues ({', '.join(paths)}); a sentence has one home")
for problem in problems[:60]:
    print("FAIL: " + problem, file=sys.stderr)
if len(problems) > 60:
    print(f"FAIL: … and {len(problems) - 60} more", file=sys.stderr)
sys.exit(1 if problems else 0)
PY
  then failed=1; fi
  # A sentence in a catalogue is one some code says. The catalogues carry no extraction state (the iOS one is edited by hand, the
  # others are synced only by scripts/localize), so `stale` never shows a sentence the code stopped saying: the code is read here.
  # Each catalogue is read by its own code: the iOS app's, the Mac app's with PurlayMacUI, and PurlayWords'.
  if ! python3 - "$root" <<'PY'
import json, pathlib, re, sys
root = pathlib.Path(sys.argv[1])
readers = {
    "Apps/iOS/App/Resources/Localizable.xcstrings": ["Apps/iOS/App"],
    "Apps/macOS/App/Resources/Localizable.xcstrings": ["Apps/macOS/App", "Sources/PurlayMacUI"],
    "Sources/PurlayWords/Resources/Localizable.xcstrings": ["Sources/PurlayWords"],
}
spec = re.compile(r"%(?:\d+\$)?(?:lld|ld|lu|llu|@|d|u|f)")
escapes = {"n": "\n", "t": "\t", '"': '"', "\\": "\\", "'": "'", "0": "\0"}

def literal(text, i):
    """The Swift string literal opening at text[i], each interpolation as NUL, and the index after it."""
    if text.startswith('"""', i):
        end = text.index('"""', i + 3)
        lines = text[i + 3:end].strip("\n").split("\n")
        indent = min((len(line) - len(line.lstrip()) for line in lines if line.strip()), default=0)
        return "\n".join(line[indent:] for line in lines), end + 3
    value, i = [], i + 1
    while i < len(text) and text[i] not in '"\n':
        if text[i] != "\\":
            value.append(text[i]); i += 1
        elif text[i + 1] == "(":
            depth, i = 1, i + 2
            while depth:
                if text[i] == '"':
                    _, i = literal(text, i)
                    continue
                depth += {"(": 1, ")": -1}.get(text[i], 0); i += 1
            value.append("\0")
        elif text[i + 1] == "u":
            close = text.index("}", i)
            value.append(chr(int(text[i + 3:close], 16))); i = close + 1
        else:
            value.append(escapes.get(text[i + 1], text[i + 1])); i += 2
    return "".join(value), i + 1

def said(folders):
    found = set()
    for folder in folders:
        for path in sorted((root / folder).rglob("*.swift")):
            text, i = re.sub(r"(?m)^\s*//.*$", "", path.read_text()), 0
            while (i := text.find('"', i)) != -1:
                value, i = literal(text, i)
                found.add(value)
    return found

problems = []
for path, folders in readers.items():
    sentences = said(folders)
    for key, entry in json.load(open(root / path))["strings"].items():
        if entry.get("shouldTranslate") is not False and spec.sub("\0", key) not in sentences:
            problems.append(f"{path}: {key!r} is said by no code that reads this catalogue; remove it")
for problem in problems:
    print("FAIL: " + problem, file=sys.stderr)
sys.exit(1 if problems else 0)
PY
  then failed=1; fi

  # --- The Mac app.
  # The icon is the whole set the catalogue names, each at its own pixel size; scripts/icon writes it from Design/purlay.svg.
  local macset="$root/Apps/macOS/App/Resources/Assets.xcassets/AppIcon.appiconset" entry file pixels
  for entry in icon_16x16.png:16 icon_16x16@2x.png:32 icon_32x32.png:32 icon_32x32@2x.png:64 icon_128x128.png:128 \
    icon_128x128@2x.png:256 icon_256x256.png:256 icon_256x256@2x.png:512 icon_512x512.png:512 icon_512x512@2x.png:1024; do
    file="${entry%%:*}"; pixels="${entry##*:}"
    if [ ! -f "$macset/$file" ] || ! grep -q "\"$file\"" "$macset/Contents.json"; then
      echo "FAIL: the Mac icon set lacks $file" >&2; failed=1
    elif [ "$(png_field "$macset/$file" 16 4)x$(png_field "$macset/$file" 20 4)" != "${pixels}x${pixels}" ]; then
      echo "FAIL: $file is not ${pixels}x${pixels}" >&2; failed=1
    fi
  done
  # Sparkle needs its public key to check an update's signature, and the feed it reads.
  for key in SUPublicEDKey SUFeedURL; do
    if ! python3 - "$root/Apps/macOS/Info.plist" "$key" <<'PY'
import plistlib, re, sys
plist = plistlib.loads(re.sub(rb"(?m)^#.*\n", b"", open(sys.argv[1], "rb").read()))
sys.exit(0 if str(plist.get(sys.argv[2], "")).strip() else 1)
PY
    then echo "FAIL: the Mac app's Info.plist has no $key" >&2; failed=1; fi
  done

  # --- Both apps: App Transport Security stays strict in a release build. The local-networking exception is written by the
  # Debug configuration alone, and nothing ever allows arbitrary loads.
  if grep -nE 'PURLAY_ALLOWS_LOCAL_NETWORKING|^PURLAY_PLIST_DEFINITIONS *= *[^ ]' \
      "$root"/Config/{Shared,Release,iOS,macOS,iOSTests,iOSUITests}.xcconfig; then
    echo "FAIL: a transport-security exception outside the Debug configuration" >&2; failed=1
  fi
  if grep -nE 'NSAllowsArbitraryLoads' "$root/Apps/iOS/Info.plist" "$root/Apps/macOS/Info.plist"; then
    echo "FAIL: arbitrary loads allowed" >&2; failed=1
  fi
  # The sandbox's entitlements are the allowlist; only the Debug file may add one key, and scripts/verify checks the signed apps.
  if ! python3 - "$root/Apps/macOS/App/Resources/Purlay.entitlements" "$root/Apps/macOS/App/Resources/Purlay.Debug.entitlements" <<'PY'
import plistlib, sys
allowlist = {
    "com.apple.security.app-sandbox": True,
    "com.apple.security.files.user-selected.read-write": True,
    "com.apple.security.network.client": True,
    "com.apple.security.temporary-exception.mach-lookup.global-name": [
        "$(PRODUCT_BUNDLE_IDENTIFIER)-spks", "$(PRODUCT_BUNDLE_IDENTIFIER)-spki"],
}
release = plistlib.load(open(sys.argv[1], "rb"))
debug = plistlib.load(open(sys.argv[2], "rb"))
ok = release == allowlist and debug.pop("com.apple.security.cs.disable-library-validation", None) is True and debug == allowlist
sys.exit(0 if ok else 1)
PY
  then echo "FAIL: the Mac entitlements are not the allowlist" >&2; failed=1; fi

  # --- One fact, one place: what is stated twice is checked against its source.
  # The shared modules serve every app, so they name none: an app's bundle identifier, and the platform it runs on, are handed
  # in by the app (AppIdentity, from its bundle), never defaulted to one app's in the engine.
  if grep -rnE --include='*.swift' 'dev\.purlay\.(mac|ios)\b|ClientPlatform *= *\.' "$root/Sources" | grep -v '/Generated/' \
      | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//'; then
    echo "FAIL: a shared module names one app (its bundle identifier or its platform); take it from the app" >&2; failed=1
  fi
  # The Mac's bundle identifier is the one it shipped under: the Keychain service every installed Mac keeps its session under
  # (`<bundle identifier>.session`) and Sparkle's updates both follow it, so a change signs every Mac out and strands its updates.
  if [ "$(sed -nE 's/^PRODUCT_BUNDLE_IDENTIFIER *= *//p' "$root/Config/macOS.xcconfig")" != "dev.purlay.mac" ]; then
    echo "FAIL: Config/macOS.xcconfig no longer names the shipped bundle identifier dev.purlay.mac" >&2; failed=1
  fi
  # A colour written in hex is read in one place: RGBA(hex:) in the tokens, which Color(hex:) in PurlayDesign draws through.
  if grep -rnE --include='*.swift' 'init\(hex[: ]' "$root/Sources" "$root"/Apps/*/App | grep -v '/Generated/' \
      | grep -vE "^$root/Sources/PurlayTokens/PurlayTokens.swift:|^$root/Sources/PurlayDesign/HexColor.swift:"; then
    echo "FAIL: a second hex colour decoder; use Color(hex:) or RGBA(hex:)" >&2; failed=1
  fi
  # A colour is a token. A colour written as a literal (a hex value, with or without its alpha, or components given as numbers, in
  # any colour space and through `.init` as well) is allowed only where its value is stated: the tokens (generated from the
  # server's tokens.json), the logo (Logo.swift, written from Design/purlay.svg), and NativePalette.swift, the allowlist of the
  # Mac's neutral greys and status colours, which no token states yet.
  if grep -rnE --include='*.swift' \
      '0x[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?\b|(Color|NSColor|UIColor|\.init)\((\.(sRGB|sRGBLinear|displayP3), *)?(red|srgbRed|white|hue|displayP3Red|calibratedRed|deviceRed|calibratedWhite|deviceWhite): *[0-9.]|#colorLiteral' \
      "$root/Sources" "$root"/Apps/*/App | grep -v '/Generated/' \
      | grep -vE "^$root/Sources/PurlayDesign/Logo.swift:|^$root/Sources/PurlayMacUI/NativePalette.swift:" \
      | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//'; then
    echo "FAIL: a colour literal outside the tokens, the logo and NativePalette.swift; name a token" >&2; failed=1
  fi
  # Both apps' controls are tinted with the accent token: the build names the AccentColor asset as the app's accent, and each
  # app's asset is the token's value (Sources/PurlayTokens/Generated/Colors.swift), in every appearance the asset gives.
  if ! grep -qE '^ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME *= *AccentColor$' "$root/Config/Shared.xcconfig"; then
    echo "FAIL: Config/Shared.xcconfig does not name AccentColor as the apps' accent" >&2; failed=1
  fi
  if ! python3 - "$root" <<'PY'
import json, re, sys
root = sys.argv[1]
colours = open(f"{root}/Sources/PurlayTokens/Generated/Colors.swift").read()
match = re.search(r'name: "accent",\s*light: RGBA\(hex: 0x([0-9a-fA-F]{6})\),\s*dark: RGBA\(hex: 0x([0-9a-fA-F]{6})\)', colours)
if not match:
    sys.exit("FAIL: the accent token is not in the generated colours")
token = {"light": match.group(1).lower(), "dark": match.group(2).lower()}

def byte(component):
    return int(component, 16) if component.lower().startswith("0x") else round(float(component) * 255)

problems = []
for app in ("iOS", "macOS"):
    path = f"{root}/Apps/{app}/App/Resources/Assets.xcassets/AccentColor.colorset/Contents.json"
    try:
        colours = json.load(open(path))["colors"]
    except (OSError, KeyError, ValueError):
        problems.append(f"the {app} app has no AccentColor asset")
        continue
    for entry in colours:
        dark = any(a.get("appearance") == "luminosity" and a.get("value") == "dark" for a in entry.get("appearances", []))
        parts = entry["color"]["components"]
        value = "".join(f"{byte(parts[c]):02x}" for c in ("red", "green", "blue"))
        if entry["color"].get("color-space") != "srgb" or value != token["dark" if dark else "light"]:
            problems.append(f"the {app} AccentColor is #{value}, not the accent token #{token['dark' if dark else 'light']}")
for problem in problems:
    print("FAIL: " + problem, file=sys.stderr)
sys.exit(1 if problems else 0)
PY
  then failed=1; fi
  # Who the retained data belongs to is kept one way, by PurlayKit's DefaultsOwner, for both apps.
  if grep -rnE --include='*.swift' '(struct|class) DefaultsOwner\b' "$root/Sources" "$root"/Apps/*/App \
      | grep -v "^$root/Sources/PurlayKit/App/DefaultsOwner.swift:"; then
    echo "FAIL: a second DefaultsOwner; use PurlayKit's" >&2; failed=1
  fi
  # A scheme names the app it builds as the build names it (PRODUCT_NAME, Config/Shared.xcconfig).
  local product
  product="$(sed -nE 's/^PRODUCT_NAME *= *//p' "$root/Config/Shared.xcconfig")"
  if grep -nE 'BuildableName = "[^"]*\.app"' "$root"/Apps/Purlay.xcodeproj/xcshareddata/xcschemes/*.xcscheme \
      | grep -v "BuildableName = \"$product.app\""; then
    echo "FAIL: a scheme names an app other than $product.app" >&2; failed=1
  fi
  # Both apps register their URL type alike: the same name (the app's own bundle identifier) and the same scheme.
  if ! python3 - "$root/Apps/iOS/Info.plist" "$root/Apps/macOS/Info.plist" <<'PY'
import plistlib, re, sys
types = [plistlib.loads(re.sub(rb"(?m)^#.*\n", b"", open(path, "rb").read())).get("CFBundleURLTypes") for path in sys.argv[1:]]
expected = [{"CFBundleURLName": "$(PRODUCT_BUNDLE_IDENTIFIER)", "CFBundleURLSchemes": ["$(PURLAY_URL_SCHEME)"]}]
sys.exit(0 if all(entry == expected for entry in types) else 1)
PY
  then echo "FAIL: the apps' URL types differ, or are not named by the bundle identifier" >&2; failed=1; fi
  # Every shared configuration file is in the project's Config group, so it is seen where the others are.
  local config
  for config in "$root"/Config/*.xcconfig; do
    case "$(basename "$config")" in BuildNumber.xcconfig | Local.xcconfig) continue ;; esac
    if ! grep -qF "{ \"path\": \"$(basename "$config")\" }" "$root/Apps/Purlay.xcodeproj/project.xcproj"; then
      echo "FAIL: $(basename "$config") is not in the project's Config group" >&2; failed=1
    fi
  done
  # A package test suite is not named like an app's test target, so a test's name says where it runs.
  if grep -rnE --include='*.swift' '^(struct|final class|class) (PurlayTests|PurlayUITests)\b' "$root/Tests"; then
    echo "FAIL: a package test suite named like an iOS test target" >&2; failed=1
  fi
  # The app's URL scheme is the server's: the scheme of `nativeRedirect` in the generated constants. The scheme both apps
  # register (PURLAY_URL_SCHEME, which Info.plist cannot ask Swift for) says the same, and code asks NativeRedirect for it.
  local redirect_scheme
  redirect_scheme="$(sed -nE 's/.*nativeRedirect = "([a-z][a-z0-9+.-]*):.*/\1/p' "$root/Sources/PurlayContract/Generated/Constants.swift")"
  if [ -z "$redirect_scheme" ] \
      || [ "$(sed -nE 's/^PURLAY_URL_SCHEME *= *//p' "$root/Config/Shared.xcconfig")" != "$redirect_scheme" ]; then
    echo "FAIL: PURLAY_URL_SCHEME is not the scheme of the contract's nativeRedirect (${redirect_scheme:-none found})" >&2
    failed=1
  elif grep -rnE --include='*.swift' "(scheme[^=]*==? *\"$redirect_scheme\"|\"$redirect_scheme:)" "$root/Sources" "$root"/Apps/*/App \
      | grep -v '/Generated/' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//'; then
    echo "FAIL: the URL scheme spelt by hand; take it from NativeRedirect" >&2; failed=1
  fi
  return $failed
}

if ! $demo; then
  check . && echo "enforcement ($RULE_GROUPS): the tree holds every rule"
  exit
fi

fail=0
copy_tree() { # a copy of what the rules read, without build products
  local copy
  copy="$(mktemp -d)"
  # The generated constants and colours stay: the URL-scheme rule reads the contract's redirect there, the accent rule the token.
  rsync -a --exclude .build --exclude .swiftpm --include '/Sources/PurlayContract/Generated/***' \
    --include '/Sources/PurlayTokens/Generated/***' --exclude Generated \
    --exclude 'xcuserdata' "${TREE[@]}" "$copy"/
  echo "$copy"
}
judge() { # name copy
  if check "$2" >/dev/null 2>&1; then echo "  NOT REFUSED  $1" >&2; fail=1; else echo "  refused      $1"; fi
  rm -rf "$2"
}
plant() { # name, file (relative), line appended to it
  local copy
  wants "$group" || return 0
  copy="$(copy_tree)"
  mkdir -p "$(dirname "$copy/$2")"
  printf '%s\n' "$3" >> "$copy/$2"
  judge "$1" "$copy"
}
plant_in() { # name, folder (relative), shell command run there
  local copy
  wants "$group" || return 0
  copy="$(copy_tree)"
  (cd "$copy/$2" && eval "$3")
  judge "$1" "$copy"
}
check . >/dev/null
# The copies the violations are planted in must hold every rule before anything is planted, or a refusal would prove nothing.
clean="$(copy_tree)"
check "$clean" >/dev/null 2>&1 || { echo "  the unmodified copy already fails a rule: the demonstration proves nothing" >&2; fail=1; }
rm -rf "$clean"

