# The sentences, in each of the three catalogues.
recatalogue() { # catalogue (relative), Python statements over `strings`, the catalogue's entries
  printf 'import json; p = "%s"; c = json.load(open(p)); strings = c["strings"]; %s; json.dump(c, open(p, "w"), ensure_ascii=False)' "$1" "$2"
}
