fail=0
copy_tree() { # a copy of what the rules read, without build products
  local copy
  copy="$(mktemp -d)"
  # The generated constants and colours stay: the URL-scheme rule reads the contract's redirect there, the accent rule the token.
  rsync -a --exclude .build --exclude .swiftpm --include '/Sources/PurlayContract/Generated/***' \
    --include '/Sources/PurlayTokens/Generated/***' --exclude Generated \
    --exclude 'xcuserdata' "${TREE[@]}" "$copy"/
  echo "$copy"
}
# Each plant and fixture is a job on its own copy, run in parallel (as many at once as the machine has processors) and
# reported in the order written. A job writes one verdict line to its own file; a job whose setting-up fails reports BROKEN,
# and none stops the others.
RESULTS="$(mktemp -d)"
JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
job=0
start() { # verdict function, name, setting-up function and its arguments: one job, in the background
  local verdict="$1" name="$2"
  shift 2
  wants "$group" || return 0
  job=$((job + 1))
  # bash 3.2 (macOS's) has no `wait -n`: a free slot is looked for instead.
  while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do sleep 0.05; done
  (
    copy="$(copy_tree)"
    if "$@" "$copy"; then "$verdict" "$name" "$copy"; else echo "  BROKEN       $name (its setting-up failed)"; fi
    rm -rf "$copy"
  ) >"$RESULTS/$(printf '%04d' "$job")" 2>&1 &
}
# shellcheck disable=SC2329 # called by start()
refused() { # name copy
  if check "$2" >/dev/null 2>&1; then echo "  NOT REFUSED  $1"; else echo "  refused      $1"; fi
}
# shellcheck disable=SC2329 # called by start()
accepted() { # name copy
  local output
  if output="$(check "$2" 2>&1)"; then
    echo "  accepted     $1"
  else
    echo "  NOT ACCEPTED $1"; printf '%s\n' "$output" | grep FAIL | head -5 || true
  fi
}
# shellcheck disable=SC2329 # called by start()
append() { # file (relative), line, copy
  mkdir -p "$(dirname "$3/$1")" && printf '%s\n' "$2" >> "$3/$1"
}
# shellcheck disable=SC2329 # called by start()
run_in() { # folder (relative), shell command, copy
  (cd "$3/$1" && eval "$2")
}
plant() { start refused "$1" append "$2" "$3"; }      # name, file (relative), line appended to it
plant_in() { start refused "$1" run_in "$2" "$3"; }   # name, folder (relative), shell command run there
# A refusal shows a rule looks; it does not show the rule leaves good code alone. Each accept fixture writes code a rule must
# not refuse (a call that does say a sentence, a colour named only in a comment) and requires the copy to hold every rule.
accept_in() { start accepted "$1" run_in "$2" "$3"; } # name, folder (relative), shell command run there
check . >/dev/null
# The copies the violations are planted in must hold every rule before anything is planted, or a refusal would prove nothing.
clean="$(copy_tree)"
check "$clean" >/dev/null 2>&1 || { echo "  the unmodified copy already fails a rule: the demonstration proves nothing" >&2; fail=1; }
rm -rf "$clean"

