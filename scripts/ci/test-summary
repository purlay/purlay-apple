#!/usr/bin/env python3
"""What a test run did, from its result bundle: `xcrun xcresulttool get test-results summary --path RESULTS | scripts/ci/test-summary`.

Prints how many tests ran, passed, failed and were skipped, then each failed test and what it said: the log names a failed test
in forms that change with Xcode, the result bundle does not. A summary it cannot read is said so, with why, and exits 1: a run
that failed is never left with no name for what failed. scripts/verify runs it after every test run; the rules lane tests it
(scripts/ci/test-summary-test).
"""
import json
import sys

COUNTS = ("totalTestCount", "passedTests", "failedTests", "skippedTests")


def one_line(value, limit=400):
    """A value on one line: control characters and runs of whitespace become one space, so a name holding a newline cannot
    start a line of its own (on GitHub Actions, a line starting "::" is a workflow command)."""
    text = "".join(character if character.isprintable() else " " for character in str(value))
    return " ".join(text.split())[:limit]


def lines(summary):
    missing = [key for key in COUNTS if key not in summary]
    if missing:
        raise ValueError(f"no {', '.join(missing)}")
    yield "tests: %s in all, %s passed, %s failed, %s skipped" % tuple(one_line(summary[key], 20) for key in COUNTS)
    for failure in summary.get("testFailures", []):
        test = one_line(failure.get("testIdentifierString") or failure.get("testName"), 200)
        yield f"FAILED  {one_line(failure.get('targetName'), 100)} / {test}: {one_line(failure.get('failureText', ''))}"


def main():
    text = sys.stdin.read()
    try:
        if not text.strip():
            raise ValueError("xcresulttool gave nothing")
        output = list(lines(json.loads(text)))
    except (ValueError, TypeError, AttributeError) as problem:
        print(f"tests: the result bundle's summary could not be read ({problem})", file=sys.stderr)
        return 1
    print("\n".join(output))
    return 0


sys.exit(main())
