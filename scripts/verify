#!/usr/bin/env bash
# Everything the pipeline checks, in lanes, so that CI runs them side by side and a person runs them all.
#
#   scripts/verify               every lane, the Mac's Release build included
#   scripts/verify rules         branch name, the architecture rules and their demonstration, workflows and shell, strings (no Xcode, no Swift)
#   scripts/verify generated     the pinned contract, the generated code, the generator                (needs Contract/bundle)
#   scripts/verify packages      the layers, format, and every package test on macOS (TestPlans/macOS) (needs Contract/bundle)
#   scripts/verify ios           the package and the iOS app, built for the simulator
#   scripts/verify macos [CONFIGS]  the Mac app (Debug, or the configurations named): App Transport Security, entitlements
#   scripts/verify simulator     the iOS tests on a simulator (TestPlans/iOS)
#   scripts/verify security      the whole history scanned for secrets (gitleaks, at the version scripts/install-gitleaks pins)
#
# A pull request runs rules, packages, ios and macos (`make verify`), generated when the contract or the generator changes, and
# security on its own runner. A simulator costs minutes on a hosted runner, so `simulator` runs on main, nightly,
# and for a pull request that changes the iOS app or the design system. The UI tests sign in against a real server and skip
# without one. PURLAY_PACKAGES_DIR, when set, is where xcodebuild keeps the packages it fetches.
#
# Every build is numbered with the commit count (scripts/build-number), and compilation is cached by content (Xcode's compilation
# cache) in PURLAY_CACHE_DIR, so a build in a fresh checkout reuses what an earlier one compiled. PURLAY_DERIVED_DATA, when set,
# is where xcodebuild puts what it builds (Xcode's own folder otherwise). CI builds with Xcode 27; set DEVELOPER_DIR to select it
# locally.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Each lane is a sequence of phases (resolve, build, boot, test, check…). `step PHASE DESCRIPTION` starts one: the log shows the
# time of day and, when the phase ends, how long it took; at the end the phases are written as a table to $GITHUB_STEP_SUMMARY
# (in CI), against the target the run is held to (PURLAY_TARGET_SECONDS: 180 for a pull request, 600 for a release).
PHASE="" PHASE_STARTED=0 PHASES=()
end_phase() {
  [ -n "$PHASE" ] || return 0
  local took=$((SECONDS - PHASE_STARTED))
  PHASES+=("$PHASE|$took")
  printf '    [%s] %s took %d s\n' "$(date -u +%H:%M:%S)" "$PHASE" "$took"
  PHASE=""
}
step() { # phase description
  end_phase
  PHASE="$1" PHASE_STARTED=$SECONDS
  printf '\n\033[1m==> [%s] %s: %s\033[0m\n' "$(date -u +%H:%M:%S)" "$1" "$2"
}
report_phases() {
  local status=$? row
  end_phase
  [ -n "${GITHUB_STEP_SUMMARY:-}" ] && [ "${#PHASES[@]}" -gt 0 ] || return "$status"
  {
    echo "#### scripts/verify ${LANE}: ${SECONDS} s ($([ "$status" -eq 0 ] && echo passed || echo FAILED)), within a run held to ${PURLAY_TARGET_SECONDS:-180} s"
    echo
    echo "| Phase | Seconds |"
    echo "|---|---:|"
    for row in "${PHASES[@]}"; do echo "| ${row%|*} | ${row##*|} |"; done
    echo
  } >>"$GITHUB_STEP_SUMMARY"
  return "$status"
}
LANE="${*:-all}"
trap report_phases EXIT

PROJECT=Apps/Purlay.xcodeproj
CAS="${PURLAY_CACHE_DIR:-$HOME/Library/Caches/dev.purlay/compilation-cache}"
# xcodebuild's -quiet hides what a failed test asserted, so the output is kept and, on a failure, the lines that say what failed
# are printed with the end of it.
quiet() { # xcodebuild arguments
  local log status=0 results
  log="$(mktemp)"
  xcodebuild ${PURLAY_DERIVED_DATA:+-derivedDataPath "$PURLAY_DERIVED_DATA"} \
    ${PURLAY_PACKAGES_DIR:+-clonedSourcePackagesDirPath "$PURLAY_PACKAGES_DIR"} "$@" >"$log" 2>&1 || status=$?
  # How many tests ran, passed, failed and were skipped, from the result bundle, so that a passing log says it too.
  results="$(sed -nE 's/^[[:space:]]+(\/.*\.xcresult)$/\1/p' "$log" | tail -n 1)"
  [ -z "$results" ] || xcrun xcresulttool get test-results summary --path "$results" 2>/dev/null | python3 -c '
import json, sys
s = json.load(sys.stdin)
counts = tuple(s.get(key) for key in ("totalTestCount", "passedTests", "failedTests", "skippedTests"))
print("tests: %s in all, %s passed, %s failed, %s skipped" % counts)' || true
  if [ "$status" -ne 0 ]; then
    grep -E "error:|✘|recorded an issue|Expectation failed|Failing tests|\*\* (TEST|BUILD) FAILED" "$log" | sort -u | head -40 >&2 || true
    echo "--- the end of the log:" >&2
    tail -25 "$log" >&2
  fi
  rm -f "$log"
  return "$status"
}
cached() { # xcodebuild arguments, with the compilation cache on
  quiet "$@" COMPILATION_CACHE_ENABLE_CACHING=YES COMPILATION_CACHE_CAS_PATH="$CAS" COMPILER_INDEX_STORE_ENABLE=NO
}
resolve() { # scheme: the project's packages (Sparkle), timed apart from the build
  step resolve "the packages of $1"
  quiet -project "$PROJECT" -scheme "$1" -resolvePackageDependencies
}

built_app() { # scheme configuration [destination]: the path of the app that configuration builds
  xcodebuild ${PURLAY_DERIVED_DATA:+-derivedDataPath "$PURLAY_DERIVED_DATA"} -project "$PROJECT" -scheme "$1" -configuration "$2" \
    ${3:+-destination "$3"} -showBuildSettings 2>/dev/null \
    | awk -F' = ' '/ BUILT_PRODUCTS_DIR /{print $2; exit}'
}

# The app says the build number it was given: the commit count, above the last build the Mac shipped.
check_build_number() { # Info.plist
  local expected actual
  expected="$(sed -n 's/^CURRENT_PROJECT_VERSION = //p' Config/BuildNumber.xcconfig)"
  actual="$(plutil -extract CFBundleVersion raw -o - "$1")"
  [ "$actual" = "$expected" ] || { echo "FAIL: $1 says build $actual, not $expected" >&2; exit 1; }
  echo "ok  build $actual"
}

rules() {
  step check "branch name"
  scripts/check-branch
  step check "architecture rules, and the demonstration that each one refuses its violation"
  # The layer rule compiles the manifest, which needs Swift; it runs in packages, on macOS, so that this lane needs neither.
  scripts/enforcement tree
  scripts/enforcement --demo tree
  step check "the lanes each change runs (scripts/ci/changes)"
  scripts/ci/changes-test >/dev/null
  step check "workflows (actionlint) and shell scripts (shellcheck), at the versions scripts/install-lint-tools pins"
  lint_tools="$(scripts/install-lint-tools)"
  PATH="$lint_tools:$PATH" actionlint -config-file .github/actionlint.yaml
  git ls-files scripts .githooks | while IFS= read -r file; do
    head -n 1 "$file" | grep -qE '^#!.*(bash|/sh)' && printf '%s\n' "$file"
  done | PATH="$lint_tools:$PATH" xargs shellcheck -x
  step check "a pull request's title is a conventional commit (scripts/ci/check-pr-title)"
  scripts/ci/check-pr-title-test >/dev/null
  step check "the release gate refuses what it must (scripts/ci/release-gate)"
  scripts/ci/release-gate-test >/dev/null
  step check "every string of the Mac app has its Turkish translation"
  scripts/localize --check
}

generated() {
  step check "the contract bundle is the one the lock pins, and the generated code is what it generates"
  scripts/contract verify
  scripts/generate --check
  step test "the generator: build and test"
  (cd Tools/PurlayGen && swift test 2>&1 | grep -q "Test run with .* passed") || { echo "FAIL: Tools/PurlayGen" >&2; exit 1; }
}

format() {
  step format "every Swift file"
  find Sources Tests Apps ContractTests Tools -name '*.swift' -not -path '*/.build/*' -not -path '*/Generated/*' -print0 \
    | xargs -0 xcrun swift-format lint --strict --parallel
}

packages() {
  # The layer rule reads the manifest through SwiftPM: about 30 s on the runner, most of it SwiftPM starting. It runs beside the
  # format check and the packages' fetch, which wait on the disk and the network, and is judged after them.
  local layers layers_log
  layers_log="$(mktemp)"
  (scripts/enforcement layers && scripts/enforcement --demo layers) >"$layers_log" 2>&1 &
  layers=$!
  format
  resolve Purlay-macOS
  step check "the layers, read from the manifest by SwiftPM, and the demonstration that the rule refuses each violation"
  if ! wait "$layers"; then cat "$layers_log" >&2; rm -f "$layers_log"; exit 1; fi
  cat "$layers_log"; rm -f "$layers_log"
  local snapshots test=(-project "$PROJECT" -scheme Purlay-macOS -testPlan macOS -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO)
  step build "every package test target, for macOS"
  cached "${test[@]}" build-for-testing
  step test "every package test on macOS, and the Mac screens drawn from state, light and dark (pictures in a temporary folder)"
  snapshots="$(mktemp -d)"
  # The test targets run side by side, each suite in one of several processes: on macOS a worker is a process, not a device.
  TEST_RUNNER_PURLAY_SNAPSHOT_DIR="$snapshots" cached "${test[@]}" -parallel-testing-enabled YES test-without-building
  [ -n "$(ls "$snapshots" 2>/dev/null)" ] || { echo "FAIL: no screen was drawn" >&2; exit 1; }
  rm -rf "$snapshots"
}

ios() {
  scripts/build-number
  step build "every module of the package, built for iOS 18 and later"
  cached -scheme purlay-apple-Package -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build
  resolve Purlay-iOS
  step build "the iOS app, built for the simulator"
  cached -project "$PROJECT" -scheme Purlay-iOS -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build
  check_build_number "$(built_app Purlay-iOS Debug 'generic/platform=iOS Simulator')/Purlay.app/Info.plist"
}

macos() { # configurations to build and check
  local configurations="$1" configuration app has signed
  scripts/build-number
  resolve Purlay-macOS
  step build "the Mac app: $configurations"
  for configuration in $configurations; do
    cached -project "$PROJECT" -scheme Purlay-macOS -configuration "$configuration" -destination 'platform=macOS' build
    check_build_number "$(built_app Purlay-macOS "$configuration")/Purlay.app/Contents/Info.plist"
  done

  step check "App Transport Security stays strict in Release and is relaxed for localhost in Debug only"
  for configuration in $configurations; do
    app="$(built_app Purlay-macOS "$configuration")/Purlay.app"
    has=false; plutil -extract NSAppTransportSecurity xml1 -o - "$app/Contents/Info.plist" >/dev/null 2>&1 && has=true
    case "$configuration:$has" in
      Debug:true|Release:false) echo "ok  $configuration" ;;
      *) echo "FAIL: $configuration has ATS exception = $has" >&2; exit 1 ;;
    esac
  done

  step check "the sandbox and the entitlements are the allowlist and nothing else"
  canonical() { python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin), sort_keys=True, separators=(",", ":")))'; }
  allowlist='{"com.apple.security.app-sandbox":true,"com.apple.security.files.user-selected.read-write":true,"com.apple.security.network.client":true,"com.apple.security.temporary-exception.mach-lookup.global-name":["dev.purlay.mac-spks","dev.purlay.mac-spki"]}'
  # shellcheck disable=SC2016 # the literal $(PRODUCT_BUNDLE_IDENTIFIER) is what is replaced
  entitlements="$(plutil -convert json -o - Apps/macOS/App/Resources/Purlay.entitlements | python3 -c 'import sys; print(sys.stdin.read().replace("$(PRODUCT_BUNDLE_IDENTIFIER)", "dev.purlay.mac"))' | canonical)"
  [ "$entitlements" = "$allowlist" ] || { echo "FAIL: entitlements are not the allowlist: $entitlements" >&2; exit 1; }
  # shellcheck disable=SC2016 # the literal $(PRODUCT_BUNDLE_IDENTIFIER) is what is replaced
  debug_entitlements="$(plutil -convert json -o - Apps/macOS/App/Resources/Purlay.Debug.entitlements | python3 -c '
import json,sys
held=json.load(sys.stdin)
assert held.pop("com.apple.security.cs.disable-library-validation") is True
print(json.dumps(held).replace("$(PRODUCT_BUNDLE_IDENTIFIER)", "dev.purlay.mac"))' | canonical)"
  [ "$debug_entitlements" = "$allowlist" ] || { echo "FAIL: unexpected Debug entitlements" >&2; exit 1; }
  echo "ok  declared"
  # Check the signed app too. Debug alone permits debugging and loading Sparkle under ad-hoc signing.
  for configuration in $configurations; do
    app="$(built_app Purlay-macOS "$configuration")/Purlay.app"
    signed="$(codesign -d --entitlements - --xml "$app" 2>/dev/null | plutil -convert json -o - - | python3 -c '
import json, sys
held = json.load(sys.stdin)
if sys.argv[1] == "Debug":
    held.pop("com.apple.security.get-task-allow", None)
    held.pop("com.apple.security.cs.disable-library-validation", None)
print(json.dumps(held, sort_keys=True, separators=(",", ":")))' "$configuration")"
    [ "$signed" = "$allowlist" ] || { echo "FAIL: $configuration is signed with $signed" >&2; exit 1; }
    echo "ok  $configuration signed"
  done
}

# Only what needs iOS runs here (TestPlans/iOS): the app's own tests, its UI tests, and PurlayDesignTests, whose package has
# code of its own for UIKit. Every other package test is logic, tested once on macOS by `packages` (docs/development/testing.md).
#
# The build is made once for testing; then the simulator boots, and the tests run on it without building again. The boot comes
# after the build, not beside it: on the three-core hosted runner a booting simulator, and the daemons of its first minutes,
# slowed the cache's restore from seconds to 4 minutes and a warm build from 78 s to 364 s (docs/development/ci.md). One device,
# no clones: a clone costs a boot, and Swift Testing already runs a target's tests in parallel inside its process.
simulator() {
  local destination udid test
  scripts/build-number
  destination="${PURLAY_DESTINATION:-$(scripts/ci/simulator-destination | sed -nE 's/^PURLAY_DESTINATION=([^ ]+).*/\1/p')}"
  udid="${destination#id=}"
  resolve Purlay-iOS
  # One plan, built once: a second plan's build-for-testing would copy the app again, without the first plan's test bundle.
  test=(-project "$PROJECT" -scheme Purlay-iOS -testPlan iOS -destination "$destination" CODE_SIGNING_ALLOWED=NO)
  step build "the iOS app and its tests, for the simulator"
  cached "${test[@]}" build-for-testing
  step boot "the simulator"
  scripts/ci/boot-simulator start "$udid"
  scripts/ci/boot-simulator wait "$udid"
  # One invocation for the three targets: run apart (run 45892203168) they cost 269 s against 165 s together, and showed that the
  # first launch on the fresh device is the cost (PurlayTests: 221 s for 33 tests that take a second).
  step test "the iOS tests on the simulator"
  cached "${test[@]}" -parallel-testing-enabled NO test-without-building
}

security() {
  step check "no secret in the history"
  if ! command -v gitleaks >/dev/null 2>&1 || [ "$(gitleaks version 2>/dev/null | head -n 1)" != "$(sed -n 's/^VERSION=//p' scripts/install-gitleaks)" ]; then
    scripts/install-gitleaks
    # A fresh install is on the PATH of later steps in CI; a person's shell needs it said.
    PATH="${GITLEAKS_HOME:-$HOME/.local/share/purlay/gitleaks-$(sed -n 's/^VERSION=//p' scripts/install-gitleaks)}:$PATH"
  fi
  command -v gitleaks >/dev/null 2>&1 || { echo "FAIL: gitleaks could not be installed, so the history was not scanned" >&2; exit 1; }
  gitleaks git --no-banner
}

case "${1:-all}" in
  rules) rules ;;
  generated) generated ;;
  packages) packages ;;
  ios) ios ;;
  macos) macos "${2:-Debug}" ;;
  simulator) simulator ;;
  security) security ;;
  all) rules; generated; packages; ios; macos "Debug Release"; simulator; security ;;
  *) echo "usage: scripts/verify [rules|generated|packages|ios|macos [CONFIGURATIONS]|simulator|security]" >&2; exit 2 ;;
esac

end_phase
printf '\n\033[1mverify %s: everything passed\033[0m\n' "${1:-all}"
