#!/usr/bin/env bash
# Adds the sentences the code now says to the catalogues they belong to. English is the source language of every catalogue.
#
# - Sources/PurlayWords/Resources/Localizable.xcstrings: what both apps say about what the engine reports (EngineWords).
# - Apps/macOS/App/Resources/Localizable.xcstrings: the Mac app's own sentences, read by the app and PurlayMacUI (SwiftUI and
#   String(localized:) look in the main bundle).
# - The iOS app's own catalogue is edited in Xcode: its sentences are the few in Apps/iOS/App/Root/Words.swift.
#
#   scripts/localize    build the Mac app with string extraction and sync both catalogues with what the code says
#
# A new sentence shows as "new" until it has a Turkish value; scripts/enforcement (the rules lane) refuses every catalogue until
# each sentence has a final value in every language the apps declare (CFBundleLocalizations).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
MAC_CATALOG=Apps/macOS/App/Resources/Localizable.xcstrings
WORDS_CATALOG=Sources/PurlayWords/Resources/Localizable.xcstrings

derived="$(mktemp -d)"; trap 'rm -rf "$derived"' EXIT
xcodebuild -project Apps/Purlay.xcodeproj -scheme Purlay-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' \
  -derivedDataPath "$derived" SWIFT_EMIT_LOC_STRINGS=YES LOCALIZATION_PREFERS_STRING_CATALOGS=YES build >/dev/null
# The engine's words are extracted from PurlayWords' own build (PurlayWords-t.build under Xcode 27); everything else the Mac app
# and PurlayMacUI say is the Mac's.
find "$derived" -name '*.stringsdata' -path '*/PurlayWords*.build/*' -print0 \
  | xargs -0 xcrun xcstringstool sync "$WORDS_CATALOG" --stringsdata
find "$derived" -name '*.stringsdata' -not -path '*SourcePackages*' -not -path '*/PurlayWords*.build/*' -print0 \
  | xargs -0 xcrun xcstringstool sync "$MAC_CATALOG" --stringsdata
echo "synced; add the Turkish value of every new sentence, then run scripts/enforcement tree"
