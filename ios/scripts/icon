#!/usr/bin/env swift
// The app's icon, made from the logo (Design/purlay.svg): the mark on a white square, 1024 by 1024, with no alpha channel.
// The App Store refuses an icon that has one, and the system rounds the corners itself, so the picture is a full-bleed
// square and carries no shape of its own. The logo is transparent around its mark; the white behind it is this script's.
//
// It also writes the launch screen's mark (LaunchMark.imageset): the logo with its root width and height set to 120, the size
// PurlayMark has on the first frame, and the viewBox untouched so the padding is the same. scripts/enforcement checks it.
//
//   scripts/icon    write AppIcon.appiconset and LaunchMark.imageset (App/Resources/Assets.xcassets) from the logo
import AppKit

let root = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent()
let source = root.appendingPathComponent("Design/purlay.svg")
let set = root.appendingPathComponent("App/Resources/Assets.xcassets/AppIcon.appiconset")
let name = "icon-1024.png"

guard let logo = NSImage(contentsOf: source), logo.size.width > 0, logo.size.height > 0 else {
    FileHandle.standardError.write(Data("FAIL: \(source.path) cannot be read as a picture\n".utf8))
    exit(1)
}

let side = 1024
func fail(_ message: String) -> Never {
    FileHandle.standardError.write(Data("FAIL: \(message)\n".utf8))
    exit(1)
}
// An opaque context: its alpha byte is skipped, so the picture has no alpha channel to write.
guard
    let context = CGContext(
        data: nil, width: side, height: side, bitsPerComponent: 8, bytesPerRow: 0,
        space: CGColorSpace(name: CGColorSpace.sRGB)!, bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue)
else { fail("no drawing context") }
context.interpolationQuality = .high
let canvas = CGRect(x: 0, y: 0, width: side, height: side)
context.setFillColor(CGColor(red: 1, green: 1, blue: 1, alpha: 1))
context.fill(canvas)
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(cgContext: context, flipped: false)
logo.draw(in: canvas, from: .zero, operation: .sourceOver, fraction: 1)
NSGraphicsContext.restoreGraphicsState()
guard let image = context.makeImage(), let png = NSBitmapImageRep(cgImage: image).representation(using: .png, properties: [:])
else { fail("the picture cannot be written as a PNG") }

try FileManager.default.createDirectory(at: set, withIntermediateDirectories: true)
try png.write(to: set.appendingPathComponent(name))
let entry: [String: String] = ["filename": name, "idiom": "universal", "platform": "ios", "size": "1024x1024"]
let contents: [String: Any] = ["images": [entry], "info": ["author": "xcode", "version": 1]]
try JSONSerialization.data(withJSONObject: contents, options: [.prettyPrinted, .sortedKeys])
    .write(to: set.appendingPathComponent("Contents.json"))
print("wrote \(name) to \(set.path)")

let markSet = root.appendingPathComponent("App/Resources/Assets.xcassets/LaunchMark.imageset")
let markName = "purlay-mark.svg"
let markSide = 120
guard var svg = try? String(contentsOf: source, encoding: .utf8), let firstLineEnd = svg.firstIndex(of: "\n") else {
    fail("\(source.path) cannot be read as text")
}
var rootTag = String(svg[..<firstLineEnd])
for attribute in ["width", "height"] {
    guard let range = rootTag.range(of: "\(attribute)=\"1024\"") else { fail("the logo's root tag has no \(attribute)=\"1024\"") }
    rootTag.replaceSubrange(range, with: "\(attribute)=\"\(markSide)\"")
}
svg.replaceSubrange(..<firstLineEnd, with: rootTag)
try FileManager.default.createDirectory(at: markSet, withIntermediateDirectories: true)
try svg.write(to: markSet.appendingPathComponent(markName), atomically: true, encoding: .utf8)
let markContents: [String: Any] = [
    "images": [["filename": markName, "idiom": "universal"]],
    "info": ["author": "xcode", "version": 1],
    "properties": ["preserves-vector-representation": true],
]
try JSONSerialization.data(withJSONObject: markContents, options: [.prettyPrinted, .sortedKeys])
    .write(to: markSet.appendingPathComponent("Contents.json"))
print("wrote \(markName) to \(markSet.path)")
