        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitleme değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change the question or decision. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
