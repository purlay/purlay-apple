                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld unsent messages could not be restored."
                }
              }
            }
          }
        },
        "tr" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld gönderilmemiş mesaj geri yüklenemedi."
                }
              }
            }
          }
        }
      }
    },
    "%lld unsent messages were removed because you no longer have access to their channel." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld unsent message was removed because you no longer have access to its channel."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld unsent messages were removed because you no longer have access to their channel."
                }
              }
            }
          }
        },
        "tr" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Kanala erişiminiz kalmadığı için %lld gönderilmemiş mesaj kaldırıldı."
                }
              }
            }
          }
        }
      }
    },
    "A message holds at most %lld files. The rest were not added." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A message holds at most %lld file. The rest were not added."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A message holds at most %lld files. The rest were not added."
                }
              }
            }
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir mesaja en fazla %lld dosya eklenebilir. Kalanlar eklenmedi."
          }
        }
      }
    },
    "Ask whoever runs it to update the server." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuyu yönetene güncellemesini söyleyin."
          }
        }
      }
    },
    "Ask whoever runs the server to check its address settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuyu yönetene adres ayarlarını kontrol etmesini söyleyin."
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal"
