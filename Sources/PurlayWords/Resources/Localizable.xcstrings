        }
      }
    },
    "Connecting…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlanıyor…"
          }
        }
      }
    },
    "Could not change Deep Work. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derin Çalışma değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change that issue. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sorun değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change the message. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj değiştirilemedi. Bağlantınızı denetleyip yeniden deneyin."
