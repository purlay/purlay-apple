      }
    },
    "Use a web address, starting with https." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https ile başlayan bir web adresi kullanın."
          }
        }
      }
    },
    "Waiting for the Browser…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı bekleniyor…"
          }
        }
      }
    },
    "Workspace" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma Alanı"
          }
        }
      }
    },
    "You are signed out here. The server could not be reached, so this session stays valid there until it expires." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada oturumunuz kapandı. Sunucuya ulaşılamadığı için bu oturum, süresi dolana kadar orada geçerli kalır."
          }
        }
      }
    },
    "You are signed out." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz kapalı."
          }
        }
      }
    },
    "You are the last member of this private channel, so you can't leave it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu özel kanalın son üyesisiniz, bu yüzden ayrılamazsınız."
          }
        }
      }
    },
    "You are the last owner of %lld workspaces with other people in them. Make someone else an owner first." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You are the last owner of %lld workspace with other people in it. Make someone else an owner first."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You are the last owner of %lld workspaces with other people in them. Make someone else an owner first."
                }
              }
            }
          }
        },
        "tr" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Başka kişilerin de olduğu %lld çalışma alanının son sahibisiniz. Önce başka birini sahip yapın."
                }
              }
            }
          }
        }
      }
    },
    "You are the last owner of a workspace with other people in it. Make someone else an owner first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka kişilerin de olduğu bir çalışma alanının son sahibisiniz. Önce başka birini sahip yapın."
          }
        }
      }
    },
    "You can add at most %lld reactions to a message. Remove one to add another." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You can add at most %lld reaction to a message. Remove one to add another."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You can add at most %lld reactions to a message. Remove one to add another."
                }
              }
            }
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir mesaja en fazla %lld tepki ekleyebilirsiniz. Başka eklemek için birini kaldırın."
          }
        }
      }
    },
    "You have saved as many messages as Purlay keeps. Let some go to save more." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purlay'ın tutabileceği en fazla mesajı kaydettiniz. Daha fazlasını kaydetmek için bazılarını bırakın."
          }
        }
      }
    },
    "You no longer have access here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık buraya erişiminiz yok."
          }
        }
      }
    },
    "You signed in with a different account. Sign in again with this one." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı bir hesapla oturum açtınız. Bu hesapla yeniden oturum açın."
          }
        }
      }
    },
    "You were signed out before your account was deleted. Sign in and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız silinmeden önce oturumunuz kapandı. Oturum açıp yeniden deneyin."
          }
        }
      }
    },
    "You were signed out by the server. Sign in again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu oturumunuzu kapattı. Yeniden oturum açın."
          }
        }
      }
    },
    "You were signed out." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz kapatıldı."
          }
        }
      }
    },
    "Your account could not be deleted. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız silinemedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        }
      }
    },
    "Your account was deleted." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız silindi."
          }
        }
      }
    },
    "Your account was probably deleted: you were signed out before the server could confirm it. What Purlay kept on this device was removed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız büyük olasılıkla silindi: sunucu bunu doğrulayamadan oturumunuz kapandı. Purlay'in bu cihazda tuttukları kaldırıldı."
          }
        }
      }
    },
    "Your message to %@ was not sent: a file did not upload. Your words are back in the box." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için yazdığınız mesaj gönderilmedi: bir dosya yüklenemedi. Yazdıklarınız kutuya geri döndü."
          }
        }
      }
    },
    "Your message was not sent: a file did not upload. Your words are back in the box." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajınız gönderilmedi: bir dosya yüklenemedi. Yazdıklarınız kutuya geri döndü."
          }
        }
      }
    },
    "Your session ends on %@. Sign out and in again before then to stay connected." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz %@ tarihinde sona eriyor. Bağlı kalmak için o zamandan önce oturumu kapatıp yeniden açın."
          }
        }
      }
    },
    "Your session has ended. Sign in again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz sona erdi. Yeniden oturum açın."
          }
        }
      }
    },
    "Your session has expired. Sign in again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuzun süresi doldu. Yeniden oturum açın."
          }
        }
      }
    },
    "Your unsent messages could not be read and were set aside." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderilmemiş mesajlarınız okunamadı ve kenara alındı."
          }
        }
      }
    }
