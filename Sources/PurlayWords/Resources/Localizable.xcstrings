    },
    "Could not change the save. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetme değiştirilemedi. Yeniden dene."
          }
        }
      }
    },
    "Could not change the star. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıldız değiştirilemedi. Yeniden dene."
          }
        }
      }
    },
    "Could not change whether Purlay opens at login. Check System Settings > General > Login Items." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
