        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanallar"
          }
        }
      }
    },
    "Check your connection, then try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantınızı kontrol edin, sonra yeniden deneyin."
