      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitleme değiştirilemedi. Yeniden dene."
          }
        }
      }
    },
    "Could not change the question or decision. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soru veya karar değiştirilemedi. Bağlantını denetleyip yeniden dene."
          }
        }
