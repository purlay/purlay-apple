    },
    "Could not change the star. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıldız değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change whether Purlay opens at login. Check System Settings > General > Login Items." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purlay’in girişte açılma ayarı değiştirilemedi. Sistem Ayarları > Genel > Giriş Öğeleri’ni denetleyin."
          }
        }
      }
    },
    "Could not change whether this thread is resolved. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konunun çözüldü durumu değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change whether you follow this thread. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konuyu takip etme durumunuz değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change your away status. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzakta durumunuz değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not change your groups. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruplarınız değiştirilemedi. Yeniden deneyin."
          }
        }
      }
    },
    "Could not delete the message. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj silinemedi. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not leave the channel. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanaldan ayrılınamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not load messages. Check your connection." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajlar yüklenemedi. Bağlantınızı denetleyin."
          }
        }
      }
    },
    "Could not load the thread. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konu yüklenemedi. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not mark that as read. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okundu olarak işaretlenemedi. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not mark that as unread. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okunmadı olarak işaretlenemedi. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not open that. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not react to the message. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaja tepki verilemedi. Bağlantınızı denetleyip yeniden deneyin."
          }
        }
      }
    },
    "Could not read %@. Check that it is still there, then attach it again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ okunamadı. Hâlâ yerinde olup olmadığını denetleyip yeniden ekleyin."
          }
        }
      }
    },
    "Could not remove the bookmark. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yer imi kaldırılamadı. Yeniden deneyin."
          }
        }
      }
    },
    "Could not save the file there. Choose another place and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya oraya kaydedilemedi. Başka bir yer seçip yeniden deneyin."
          }
        }
      }
    },
    "Could not save your profile. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiliniz kaydedilemedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        }
      }
    },
    "Could not sign out everywhere. You are still signed in." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yerde oturum kapatılamadı. Oturumunuz hâlâ açık."
          }
        }
      }
    },
    "Could not sign out: the server could not be reached and this device could not forget the sign-in. You are still signed in." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum kapatılamadı: sunucuya ulaşılamadı ve bu cihaz oturum bilgisini silemedi. Oturumunuz hâlâ açık."
          }
        }
      }
    },
    "Dismiss" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapat"
          }
        }
      }
    },
    "File storage is unavailable right now." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya deposu şu an kullanılamıyor."
          }
        }
      }
    },
    "Give only the server's address, without a path." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca sunucu adresini yazın, yol eklemeden."
          }
        }
      }
    },
    "It needs version %@ or newer." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya da daha yeni bir sürüm gerekir."
          }
        }
      }
    },
    "Jump to Latest" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Yeniye Git"
          }
        }
      }
    },
    "Leave the user name and password out of the address." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adını ve parolayı adrese eklemeyin."
          }
        }
      }
    },
    "Load Earlier Messages" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki Mesajları Yükle"
          }
        }
      }
    },
    "Loading your workspace…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma alanınız yükleniyor…"
          }
        }
      }
    },
    "No connection." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı yok."
          }
        }
      }
    },
    "Purlay could not read your saved sign-in on this device. Sign in again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purlay bu cihazdaki kayıtlı oturumunuzu okuyamadı. Yeniden oturum açın."
          }
        }
      }
    },
    "Purlay could not tell whether your account was deleted: the answer did not arrive. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızın silinip silinmediği anlaşılamadı: yanıt gelmedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        }
      }
    },
    "Refresh" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenile"
          }
        }
      }
    },
    "Sending…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderiliyor…"
          }
        }
      }
    },
    "Sent" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderildi"
          }
        }
      }
    },
    "Server Unavailable" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuya Ulaşılamıyor"
          }
        }
      }
    },
    "Sign Out Everywhere" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her Yerde Oturumu Kapat"
          }
        }
      }
    },
    "Sign Out Everywhere…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her Yerde Oturumu Kapat…"
          }
        }
      }
    },
    "Sign out of %@ first to use another account." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir hesap kullanmak için önce %@ sunucusunda oturumu kapatın."
          }
        }
      }
    },
    "Some of your data on this device could not be removed. Purlay tries again when you next sign out, or when someone else signs in here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdaki verilerinizin bir kısmı silinemedi. Purlay bir sonraki oturum kapatışında ya da burada başka biri oturum açtığında yeniden dener."
          }
        }
      }
    },
    "Someone else changed this question or decision first. It now shows their change; review it and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu soruyu veya kararı önce başka biri değiştirdi. Şimdi onun değişikliği görünüyor; inceleyip yeniden deneyin."
          }
        }
      }
    },
    "Starred" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıldızlı"
          }
        }
      }
    },
    "That doesn't look like a Purlay server" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir Purlay sunucusuna benzemiyor"
          }
        }
      }
    },
    "That is not an address a browser would open." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bir tarayıcının açacağı bir adres değil."
          }
        }
      }
    },
    "That is not your username. Type it exactly as it is shown." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sizin kullanıcı adınız değil. Tam olarak gösterildiği gibi yazın."
          }
        }
      }
    },
    "That message is too long to send." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mesaj göndermek için çok uzun."
          }
        }
      }
    },
    "That sign-in expired or was already used. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum açma isteğinin süresi doldu veya zaten kullanıldı. Yeniden deneyin."
          }
        }
      }
    },
    "The address answered, but not as Purlay does." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres yanıt verdi, ancak Purlay gibi değil."
          }
        }
      }
    },
    "The browser could not be opened." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı açılamadı."
          }
        }
      }
    },
    "The file could not be sent." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya gönderilemedi."
          }
        }
      }
    },
    "The server asks you to wait a moment." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu biraz beklemenizi istiyor."
          }
        }
      }
    },
    "The server could not be reached." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuya ulaşılamadı."
          }
        }
      }
    },
    "The server did not accept this sign-in." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu oturum açma isteğini kabul etmedi."
          }
        }
      }
    },
    "The server did not start a session. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bir oturum başlatmadı. Yeniden deneyin."
          }
        }
      }
    },
    "The server gave an address this app can't use" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu, bu uygulamanın kullanamayacağı bir adres verdi"
          }
        }
      }
    },
    "The server is busy." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu meşgul."
          }
        }
      }
    },
    "The server refused this app's connection. Check the server's address." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu uygulamanın bağlantısını reddetti. Sunucu adresini kontrol edin."
          }
        }
      }
    },
    "The session could not be saved to your Keychain." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum Anahtar Zinciri'ne kaydedilemedi."
          }
        }
      }
    },
    "The sign-in did not come back the way it should. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma olması gerektiği gibi geri dönmedi. Yeniden deneyin."
          }
        }
      }
    },
    "The workspace's storage is full. %@ left." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma alanının depolama alanı dolu. %@ kaldı."
          }
        }
      }
    },
    "This account cannot be deleted from here. Open Purlay on the web to see why." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesap buradan silinemez. Nedenini görmek için Purlay'i web'de açın."
          }
        }
      }
    },
    "This channel has as many pinned messages as it can hold. Unpin one first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kanal alabileceği en fazla sabitlenmiş mesaja sahip. Önce birinin sabitlemesini kaldırın."
          }
        }
      }
    },
    "This file is empty." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosya boş."
          }
        }
      }
    },
    "This file is larger than the limit of %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosya %@ sınırından büyük."
          }
        }
      }
    },
    "This kind of file is not accepted." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tür dosyalar kabul edilmiyor."
          }
        }
      }
    },
    "This picture cannot be read." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu resim okunamıyor."
          }
        }
      }
    },
    "This picture is larger than Purlay can take." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu resim Purlay'ın kabul edebileceğinden büyük."
          }
        }
      }
    },
    "This server is older than this app supports" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu, bu uygulamanın desteklediğinden daha eski"
          }
        }
      }
    },
    "This server must be reached over https." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucuya https üzerinden ulaşılmalı."
          }
        }
      }
    },
    "This server needs a newer Purlay" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu daha yeni bir Purlay gerektiriyor"
          }
        }
      }
    },
    "To delete your account, sign in again first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı silmek için önce yeniden oturum açın."
          }
        }
      }
    },
    "Too many attempts. Wait a moment and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla deneme yapıldı. Biraz bekleyip yeniden deneyin."
          }
        }
      }
    },
    "Too many files are waiting. Send or remove some first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla dosya bekliyor. Önce bazılarını gönderin veya kaldırın."
          }
        }
      }
    },
    "Too many requests" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla istek"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden Dene"
          }
        }
      }
    },
    "Two-Step Verification Required" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki Adımlı Doğrulama Gerekli"
          }
        }
      }
    },
    "Type the address of your Purlay server." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purlay sunucunuzun adresini yazın."
          }
